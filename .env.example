# Zyra Net API — Environment Variables
# Copy this to .env and fill in real values for production.

# --- App ---
APP_ENV=local
APP_PORT=8080

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zyranet
DB_USER=root
DB_PASS=your_db_password_here

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRY=24h

# --- Auth cookie ---
# Leave blank for local dev (host-only cookie). In production set to
# .zyranet.co.ke so the session cookie set by the API is also sent to
# admin.zyranet.co.ke and portal.zyranet.co.ke.
COOKIE_DOMAIN=

# --- M-Pesa (Safaricom Daraja) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.zyranet.co.ke/api/v1/mpesa/callback
# Shared secret required (as ?token=<value>) on inbound STK callback / C2B
# validation / C2B confirmation requests, so a client that only has the
# CheckoutRequestID returned by the STK-push response can't forge a
# callback. Generate a long random value and append it to the callback/
# validation/confirmation URLs you register with Daraja.
MPESA_CALLBACK_SECRET=

# --- MikroTik router connection safety ---
# Both default to the secure behavior (verify TLS certs, reject
# private/loopback/link-local/metadata router IPs). Most ISP routers sit on
# a private IP reached over a VPN tunnel, so MIKROTIK_ALLOW_PRIVATE_IPS is
# commonly needed in real deployments, not just local dev — set it
# deliberately once you've confirmed the router is reachable only via a
# trusted private network path.
MIKROTIK_INSECURE_SKIP_VERIFY=false
MIKROTIK_ALLOW_PRIVATE_IPS=true

# --- SMS Gateway Provider ---
# Options: africastalking, hostpinnacle
SMS_PROVIDER=hostpinnacle

# --- Hostpinnacle SMS ---
# HostPinnacle's send API authenticates with just the "apikey" header (plus
# userid/mobile/msg/senderid form fields) — there is no password field in
# the request, so none is defined here.
HOSTPINNACLE_BASE_URL=https://smsportal.hostpinnacle.co.ke/SMSApi/send
HOSTPINNACLE_API_KEY=
HOSTPINNACLE_USERNAME=
HOSTPINNACLE_SENDER_ID=

# --- Africa's Talking SMS ---
# NOTE: scaffolding only — SMS_PROVIDER=africastalking is not actually
# implemented anywhere in the codebase (no AT client, no code reads these
# keys). services/sms.go only ever sends via Hostpinnacle. Keeping these
# here as a placeholder for if/when AT support is built; don't set
# SMS_PROVIDER to africastalking expecting it to do anything yet.
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=ZyraNet

# --- Error monitoring (Sentry) ---
# Leave blank to disable error reporting entirely (e.g. local dev).
SENTRY_DSN=
